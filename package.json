{
  "name": "@sylvan-stack/arbol-browser",
  "version": "1.0.0",
  "private": true,
  "description": "Arbol Browser: a shared browser component of Arbol 2.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvan-stack/arbol-browser.git"
  },
  "type": "module",
  "bin": {
    "arbol-browser": "bin/arbol-browser"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "compile": "node scripts/compile.mjs",
    "package:candidate": "node scripts/package-base.mjs",
    "package:host": "node scripts/package-host.mjs --allocated",
    "package:release-payload": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.2",
    "esbuild": "0.27.4",
    "typescript": "7.0.2"
  },
  "arbolBrowser": {
    "contract": 1,
    "profileFormat": 1,
    "runtime": {
      "electron": "45.3.2",
      "chromium": "156.0.8078.100",
      "node": "24.22.2",
      "napi": "10",
      "modules": "150",
      "platform": "darwin",
      "arch": "arm64",
      "macOS": "27.0.1"
    }
  }
}
